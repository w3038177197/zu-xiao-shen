AI_PROXY_PORT=8787
AI_PROXY_ALLOWED_ORIGIN=http://localhost:5173
AI_PROXY_PROVIDER=DeepSeek

# 生产环境建议开启来源校验；可用逗号分隔多个前端来源。
AI_PROXY_REQUIRE_ORIGIN=false
# 如需服务间调用，可设置共享令牌，并通过 x-ai-proxy-token 传递。
AI_PROXY_ACCESS_TOKEN=

# 平台统一模型 Key。访问用户不会看到也不需要填写 API Key。
# 只在服务端 .env 中配置，用于 /api/ai/chat 后端代理调用。
AI_PROXY_API_KEY=replace-with-server-side-key

# 国内常用服务商专属 Key，按你实际使用的平台填写一个即可。
# 例如默认使用 DeepSeek，就填写 DEEPSEEK_API_KEY。
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
MOONSHOT_API_KEY=
BAICHUAN_API_KEY=
HUNYUAN_API_KEY=
ARK_API_KEY=
MINIMAX_API_KEY=
OPENAI_API_KEY=

# 可选：服务端强制覆盖上游地址或模型。一般保持空，让前端服务商预设自动匹配。
AI_PROXY_BASE_URL=
AI_PROXY_MODEL=deepseek-v4-flash

# 可选：上游 AI 和离线 OCR 的超时毫秒数，服务端会限制在安全范围内。
AI_PROXY_TIMEOUT_MS=45000
OCR_TIMEOUT_MS=90000

# 可选：允许自定义网关把前端填写的 Base URL 传给代理。
# 当前前端已删除“用户自带模型”入口，建议保持 false。
AI_PROXY_ALLOW_CUSTOM_UPSTREAM=false

# 每个账号每日 AI 调用额度；小程序端使用微信 openid，Web 端使用现有账号标识。
AI_DAILY_QUOTA=40

# 微信小程序登录。AppSecret 和会话签名密钥只能配置在服务端，绝不能写入 miniapp/src。
WX_APPID=wxa9ace892fd7b06e1
WX_SECRET=
MINIAPP_SESSION_SECRET=
MINIAPP_SESSION_TTL_SECONDS=7200

# 可选：配置 Upstash Redis REST 后，微信用户每日额度和成功回答幂等缓存可跨服务重启保留。
# 生产环境必须配置；未配置时自动使用单进程内存模式，仅适合本地开发与比赛演示。
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
